# Sanity — project and dataset that hold the vehicle content
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only needed if the dataset is private (create a Viewer token in sanity.io/manage → API → Tokens)
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity webhook that calls /api/revalidate (any long random string)
SANITY_REVALIDATE_SECRET=

# NextAuth — generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Login rules (Credentials provider, until Entra ID SSO replaces it)
AUTH_ALLOWED_EMAIL_DOMAIN=agmc.com
AUTH_CREDENTIALS_PASSWORD=
